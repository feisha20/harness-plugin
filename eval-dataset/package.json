{
  "name": "@local/eval-dataset",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "KuaiBuddy 对话评测集提取插件：自动从客服历史对话中挖掘高价值样本",
  "main": "./main.js",
  "exports": {
    ".": "./main.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "api.js",
    "evaluator.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
