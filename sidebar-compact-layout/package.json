{
  "name": "@local/sidebar-compact-layout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "侧栏紧凑布局：系统菜单整行，自定义插件菜单双列，停用后恢复原布局",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-slots"]
    }
  }
}
