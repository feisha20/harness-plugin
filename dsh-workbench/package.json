{
  "name": "@mywork/dsh-workbench",
  "version": "0.1.42",
  "description": "DeepSeek Harness 个人工作台插件：采集源、待办、日报、周报与月报",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbench",
    "tasks",
    "daily-report",
    "weekly-report",
    "monthly-report"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build": "npm run build:host && npm run build:client",
    "pack": "npm run build && mkdir -p dist && npm pack --pack-destination dist"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
